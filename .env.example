SITE_ADDRESS=network.example.com
APP_URL=https://network.example.com
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Invite-only beta. Use comma-separated email addresses.
BETA_INVITE_ONLY=true
BETA_INVITE_EMAILS=
MODERATOR_EMAILS=
LEARNING_INSTRUCTOR_EMAILS=

# Optional server-side AI provider. Leave the key blank to keep generation disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DAILY_LIMIT=12

# SMTP account mail. Use the sender address your provider has verified.
MAIL_FROM="Linkedup Pro <account@network.example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
